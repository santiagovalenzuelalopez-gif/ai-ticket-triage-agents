# --- Observabilidad ---
SERVICE_NAME=ai-ticket-triage-agents
SERVICE_VERSION=1.0.0
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Rol del despliegue: all | orchestrator | vision | logs ---
SERVICE_ROLE=all

# --- LLM (mock = sin credenciales) ---
LLM_BACKEND=mock               # mock | gemini
GEMINI_API_KEY=                # inyectar desde un gestor de secretos; nunca versionar
GEMINI_MODEL=gemini-2.5-flash
FAQ_STORE_NAME=                # File Search Store con las FAQ (opcional)

# --- Entrada y comunicación entre servicios ---
WEBHOOK_TOKEN=demo-webhook-token   # secreto compartido con el helpdesk (X-Webhook-Token)
SERVICE_AUTH=none                  # none | static (dev/compose) | google (ID token OIDC en Cloud Run)
SERVICE_TOKEN=                     # solo con SERVICE_AUTH=static
SPECIALIST_TOKENS=                 # tokens aceptados por un especialista expuesto solo (coma)
VISION_URL=                        # rol orchestrator
LOGS_URL=                          # rol orchestrator
VISION_TIMEOUT_SECONDS=60
LOGS_TIMEOUT_SECONDS=45

# --- Reglas del triaje ---
NEW_TICKET_STATE=new
MAX_ARTICLES=2
TICKET_TYPE_ENABLED=true           # false: se calcula el tipo pero no se modifica el ticket
CRITICAL_THRESHOLD=9

# --- Logs ---
LOGS_BACKEND=local                 # local | ssh
LOGS_DIR=data/logs
LOGS_TIMEZONE=UTC                  # zona horaria del servidor de logs
LOGS_WINDOW_HOURS=2
CONSOLIDATE_ABOVE=10
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=
SSH_KNOWN_HOSTS=                   # obligatorio con ssh: no se aceptan claves de host nuevas
